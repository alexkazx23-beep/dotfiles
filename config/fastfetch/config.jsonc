{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    //"type": "kitty",
    "source": "archcraft2",
    "width": 25,
    // "height":20,
    "color":{
      "1":"#66800b",
      "2":"#66800b"
    },
    "padding": {
      "top": 1, // Top padding
      "left": 2, // Left padding
      "right": 2 // Right padding
    },
  },
  "display": {
    "separator": " ", // Separator between keys and values
    "color": {
      //"keys": "#66800b", // Key color module名字的颜色
      "title": "#100f0f", // Title color 主机名的颜色
      "output": "#100f0f"
    },
  },
  "modules": [
    "break",
    {
      "type": "os", //这是哪个module
      "key": "OS", //module名字的显示
      // "keyColor": "#00ff00",      //module名字颜色
      // "format": "{name} {version}",    //具体内容
      "keyColor": "#66800b",

    },
    {
      "type": "kernel",
      "key": " ├   KER ",
      "keyColor": "#66800b",

    },
    {
      "type": "packages",
      "key": " ├   PAK ",
      "format": "{all}",
      "keyColor": "#66800b",
    },
    {
      "type": "command",
      "key": " ├   AGE ",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || stat -f %B /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days",
      "keyColor": "#66800b",
    },
    {
      "type": "title",
      "key": " └   USR ",
      "keyColor": "#66800b",
    },
    "break",
    "break",
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#66800b",
   },
    {
      "type": "de",
      "key": " ├ 󱈹  DES ",
      "keyColor": "#66800b",
     //"outputColor": "#66800b"
    },
    {
      "type": "shell",
      "key": " ├   SHE ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "terminal",
      "key": " ├   TER ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "terminalfont",
      "key": " └   TFO ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    "break",
    "break",
    {
      "type": "host",
      "key": "PC ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "cpu",
      "key": " ├   CPU ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "memory",
      "key": " ├   MEM ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "swap",
      "key": " ├   SWP ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮  GPU ",
      "format": "{1} {2}",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "display",
      "key": " ├   MON ",
      "format": "{name} {width}x{height}@{refresh-rate} ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    {
      "type": "disk",
      "key": " └ 󰋊  DIS ",
      "keyColor": "#66800b",
      //"outputColor": "#66800b"
    },
    "break",
    {
      "type": "custom",
      "format": "          \u001b[31m● \u001b[32m● \u001b[33m● \u001b[34m● \u001b[35m● \u001b[36m● \u001b[37m● \u001b[90m●" // 缩减了空格，让它往左边靠拢居中
    }
  ]
}
