#!/usr/bin/env zsh

export LD_LIBRARY_PATH="$HOME/AI_Workspace/llama.cpp/build/bin:$HOME/AI_Workspace/llama.cpp/build/src:$LD_LIBRARY_PATH"

LLAMA_BIN="$HOME/AI_Workspace/llama.cpp/build/bin/llama-server"
MODEL_PATH="/mnt/E/ComfyUI-aki-v3/ComfyUI/models/LLM/Huihui-Qwen3-VL-4B-Instruct-abliterated-BF16.gguf"
MMPROJ_PATH="/mnt/E/ComfyUI-aki-v3/ComfyUI/models/LLM/mmproj-BF16.gguf"

# --- 优化后的配置：32k 上下文 + Q4 缓存 ---
$LLAMA_BIN \
    -m "$MODEL_PATH" \
    --mmproj "$MMPROJ_PATH" \
    --host 0.0.0.0 \
    --port 8081 \
    --flash-attn on \
    --n-gpu-layers 99 \
    --ctx-size 32768 \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    --batch-size 512 \
    --threads 12
